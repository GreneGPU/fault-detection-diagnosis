#!/bin/sh
set -eu
scanner="$(git config --get gitleaks.path || printf '%s' gitleaks)"
if ! command -v "$scanner" >/dev/null 2>&1; then
  echo "Install Gitleaks before pushing: https://github.com/gitleaks/gitleaks" >&2
  exit 1
fi
exec "$scanner" git . --log-opts=--all --redact --ignore-gitleaks-allow --no-banner
